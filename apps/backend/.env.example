# Copy to .env and fill in your Neon connection strings.
# Pooled URL for the backend; direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-generated-secret"
APP_ORIGIN="http://localhost:8081"
# Server only. Never use EXPO_PUBLIC_ for the Gemini key.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
# Arduino LCD: detected automatically; optionally override the connected serial port.
# DISPENSER_PORT="/dev/cu.usbmodem1101"
# DISPENSER_REQUIRE_HARDWARE=true
# Set explicitly to software for a demo without using the LCD.
# DISPENSER_MODE=software
