// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DosageForm {
  tablet
  capsule
  powder
  liquid
  cream
  inhaler
}

model Medication {
  id                   String       @id @default(uuid())
  genericName          String
  brandName            String
  ingredients          Ingredient[]
  purposes             String[]
  dosageForm           DosageForm

  frequency            String
  doseAmount           Float
  warning              String[]
  avoidWithConditions  String[]
  avoidWithIngredients String[]

  schedules            Schedule[]
}

model Ingredient {
  id           String     @id @default(uuid())
  name         String
  strengthMg   Float
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
}

enum Priority {
  low
  medium
  high
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  profile  Profile?                  // one-to-one
  schedules Schedule[]               // one user has many schedules
  pushTokens PushToken[]
}

enum Sex {
  male
  female
  other
}

model Profile {
  userId   String   @id
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex      Sex
  birthDate DateTime  @db.Date
  weightKg Float
  heightCm Float
  healthConditions HealthCondition[]
  allergies String[]
}

enum ScheduleFrequency {
  daily
  weekly
}  

model HealthCondition {
  id     String  @id @default(uuid())
  name   String
  notes  String?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
}

model Schedule {
  id           String     @id @default(uuid())
  userId       String                                   // the foreign key
  user         User       @relation(fields: [userId], references: [id])
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id])
  times        String[]
  startDate    String
  endDate      String?
  isActive     Boolean    @default(true)
  frequency     ScheduleFrequency @default(daily)
  daysOfWeek     String[]
  timezone     String     @default("UTC")
  reminderLogs     ReminderLog[]
}

model PushToken {
  id     String     @id @default(uuid())
  userId     String
  user     User     @relation(fields: [userId], references: [id])
  token     String     @unique
  createdAt     DateTime     @default(now())
}

model ReminderLog {
  id     String     @id @default(uuid())
  scheduleId     String
  schedule     Schedule @relation(fields: [scheduleId], references: [id])
  localDate     String
  time     String
  sentAt     DateTime @default(now())

  @@unique([scheduleId, localDate, time])
}
